rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public portfolio content: readable by anyone, writable only by signed-in admins
    match /clients/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /partners/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}